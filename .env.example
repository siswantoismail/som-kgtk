# ==============================================================
# ENVIRONMENT VARIABLES UNTUK CLOUD MYSQL DI VERCEL
# ==============================================================
# Anda dapat menggunakan salah satu penyedia Cloud MySQL gratis/serverless:
# - Aiven Cloud MySQL (https://aiven.io)
# - TiDB Cloud Serverless MySQL (https://tidbcloud.com)
# - PlanetScale (https://planetscale.com)
# - Atau Cloud MySQL lainnya (Clever Cloud, Hostinger, AWS RDS, GCP Cloud SQL)

# 1. Menggunakan Connection String tunggal (Paling Praktis):
MYSQL_URL=mysql://user:password@cloud-mysql-host.com:3306/sim_sop_gtk

# 2. Atau menggunakan variabel terpisah:
MYSQLHOST=cloud-mysql-host.com
MYSQLPORT=3306
MYSQLUSER=user
MYSQLPASSWORD=password
MYSQLDATABASE=sim_sop_gtk

# SSL Mode (Default: true untuk Cloud MySQL aman)
MYSQL_SSL=true

# Port lokal (Development)
PORT=3000
NODE_ENV=production
